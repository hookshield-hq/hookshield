# HookShield — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# Variables are grouped by the service that reads them.

# ── General ───────────────────────────────────────────────
# development | production
HS_ENV=development
# debug | info | warn | error
HS_LOG_LEVEL=info

# ── Service addresses ─────────────────────────────────────
HS_INGEST_ADDR=:8080
HS_API_ADDR=:8081
HS_WORKER_HEALTH_ADDR=:8082

# Public URLs (no trailing slash)
# Behind one proxy (production): HS_PUBLIC_URL=https://hooks.example.com sets the three below
# (dashboard /, API /v1, ingest /in/v1/{slug}).
# HS_PUBLIC_URL=
HS_PUBLIC_INGEST_URL=http://localhost:8080
HS_APP_URL=http://localhost:3000
# Public URL of the API (Google redirects back to $HS_API_URL/v1/auth/google/callback)
HS_API_URL=http://localhost:8081

# ── Data stores (match deploy/docker-compose.dev.yml) ─────
HS_DATABASE_URL=postgres://hookshield:hookshield@localhost:5432/hookshield?sslmode=disable
HS_REDIS_URL=redis://localhost:6379/0
# Apply pending migrations when the api boots (recommended; set false to run `api migrate up` yourself)
HS_AUTO_MIGRATE=true
# Integration tests create/drop throw-away databases through this URL (needs CREATEDB)
HS_TEST_DATABASE_URL=postgres://hookshield:hookshield@localhost:5432/hookshield?sslmode=disable
# Integration tests use isolated key namespaces in this Redis database
HS_TEST_REDIS_URL=redis://localhost:6379/15
# Namespace for every Redis key
HS_REDIS_PREFIX=hs:

# ── Ingest ────────────────────────────────────────────────
# Largest accepted webhook body in bytes (default 1 MiB)
HS_MAX_BODY_BYTES=1048576
# Requests per second per endpoint (0 disables the limit)
HS_INGEST_RATE_LIMIT=100
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For (e.g. your Caddy)
HS_TRUSTED_PROXIES=

# ── Local development ─────────────────────────────────────
# Destination of the demo endpoint created by `make seed`
# HS_SEED_TARGET=http://localhost:4000/webhook
# Make the demo destination fail the first N requests (to watch retries)
# HS_SINK_FAIL_FIRST=0

# ── Worker ────────────────────────────────────────────────
# Processor goroutines per worker process
HS_PROCESSOR_CONCURRENCY=4
# Delivery goroutines per worker process
HS_DISPATCHER_CONCURRENCY=8
# Timeout of one delivery attempt
HS_DISPATCH_TIMEOUT=15s
# Allow deliveries to private/loopback addresses (default: true in development, false in production)
# HS_ALLOW_PRIVATE_TARGETS=false

# ── Security ──────────────────────────────────────────────
# AES-256-GCM master key for payloads at rest: 32 random bytes, base64
# (openssl rand -base64 32) or 64 hex characters (openssl rand -hex 32).
# Losing this key means losing every stored payload. Back it up.
HS_ENCRYPTION_KEY=
# Or keep it in a file; a fresh install generates it there on first start.
# HS_ENCRYPTION_KEY_FILE=/var/lib/hookshield/encryption.key

# ── Dashboard auth ────────────────────────────────────────
# Browser origins allowed to call the API with cookies (comma-separated; default HS_APP_URL)
# HS_CORS_ORIGINS=http://localhost:3000
# Sliding session lifetime
HS_SESSION_TTL=720h
# Absolute session lifetime (a session ends this long after sign-in, however active)
HS_SESSION_MAX_AGE=2160h
# Secure flag on cookies (default true when HS_ENV=production; needs HTTPS)
# HS_COOKIE_SECURE=false

# Google sign-in: create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
# $HS_API_URL/v1/auth/google/callback. Leave both empty to disable Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (account emails + alert emails) ─────────────────
# Production: Resend (https://resend.com). Create an API key and verify the
# domain of HS_EMAIL_FROM. When set, Resend is used instead of SMTP.
HS_RESEND_API_KEY=
# Development: Mailpit from `make dev-up` catches everything → http://localhost:8025
# (any SMTP server also works: smtp://USER:PASS@host:587 or smtps://…:465)
HS_SMTP_URL=smtp://localhost:1025
HS_EMAIL_FROM="HookShield <no-reply@hookshield.dev>"

# ── Retention ─────────────────────────────────────────────
# How long payload logs are kept (self-hosted; no plan limits apply)
HS_RETENTION=720h

# ── Alerts ────────────────────────────────────────────────
# Minimum time between two alerts of the same endpoint (alerts in between are grouped)
HS_ALERT_COOLDOWN=10m
# HS_TELEGRAM_API_URL=https://api.telegram.org
